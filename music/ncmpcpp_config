mpd_host                    = localhost
mpd_port                    = 6600
mpd_music_dir               = ~/Music
mpd_connection_timeout      = 5

user_interface              = classic
song_list_format            = {$4%a$8 - }{%t}|{$8%f} $R {$3%l$8}
song_columns_list_format    = (30)[cyan]{a} (0)[white]{t|f:Title} (6)[green]{l}
progressbar_look            = ━━━
mouse_support               = yes
cyclic_scrolling            = no
